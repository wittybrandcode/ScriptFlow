{
  "name": "nasab",
  "description": "Islamic Inheritance and Kinship calculation engine — Enterprise Grade",
  "version": "1.0.0",
  "author": "Lida Mostefaoui & contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/islamic-inheritance/nasab.git"
  },
  "keywords": [
    "islamic",
    "inheritance",
    "kinship",
    "mawarith",
    "faraidh",
    "fiqh",
    "family-tree",
    "genealogy",
    "arabic"
  ],
  "type": "module",
  "main": "./lib/nasab.umd.js",
  "module": "./lib/nasab.es.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/nasab.es.js",
      "require": "./lib/nasab.umd.js"
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build -c vite.config.lib.ts",
    "build:lib": "vite build -c vite.config.lib.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist lib docs/api coverage",
    "lint": "tsc --noEmit",
    "lint:strict": "tsc --noEmit --strict",
    "lint:eslint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run fuzzing.test.ts --reporter=verbose",
    "test:stress": "vitest run stress_performance.test.ts --reporter=verbose",
    "test:mutation": "stryker run",
    "docs": "echo 'انظر docs/api/README.md للتوثيق اليدوي — typedoc غير متوافق مع هذه البيئة مؤقتاً'",
    "audit": "npm audit --audit-level=high",
    "check:deps": "npx knip"
  },
  "dependencies": {
    "fraction.js": "^5.3.4"
  },
  "devDependencies": {
    "@microsoft/api-documenter": "^7.30.5",
    "@microsoft/api-extractor": "^7.58.7",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.25.0",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^4.8.0",
    "knip": "^5.55.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
